#include <windows.h>
#include "Resource.h"

1 RT_MANIFEST "UI.manifest"

IDD_POWER DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Power"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Power mode", -1, 7, 7, 173, 128
    CONTROL         "Auto - battery only", IDC_MODE_AUTO, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 20, 149, 10
    CONTROL         "Always on", IDC_MODE_ALWAYS, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 56, 149, 10
    CONTROL         "Off", IDC_MODE_OFF, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 92, 149, 10
    LTEXT           "Optimize background apps while on battery.", -1, 24, 32, 149, 20
    LTEXT           "Keep power control active at all times.", -1, 24, 68, 149, 20
    LTEXT           "Disable power control completely.", -1, 24, 104, 149, 20
    GROUPBOX        "Status", -1, 7, 144, 173, 42
    LTEXT           "", IDC_STATUS, 14, 158, 159, 20
END

IDD_WHITELIST DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Whitelist"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Applications that keep full speed", -1, 7, 7, 173, 180
    CONTROL         "", IDC_LIST, "ListBox", LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP, 14, 18, 159, 124, WS_EX_CLIENTEDGE
    CONTROL         "No applications yet.", IDC_EMPTY, "Static", SS_CENTER | SS_CENTERIMAGE, 14, 18, 159, 124
    PUSHBUTTON      "Add...", IDC_ADD, 14, 150, 54, 14
    PUSHBUTTON      "Remove", IDC_REMOVE, 74, 150, 54, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Debug logging", -1, 7, 7, 173, 64
    CONTROL         "Enable debug log", IDC_LOGGING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 20, 149, 10
    LTEXT           "Save detailed logs for troubleshooting.", -1, 24, 34, 149, 20
    GROUPBOX        "Data", -1, 7, 80, 173, 92
    LTEXT           "Configuration and logs live in the", -1, 14, 94, 159, 10
    LTEXT           "application folder.", -1, 14, 106, 159, 10
    LTEXT           "Installed: C:\\Program Files\\EnergyStar", -1, 14, 124, 159, 20
    LTEXT           "Portable: the application folder", -1, 14, 146, 159, 10
END

IDD_ABOUT DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "About"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "EnergyStar", -1, 7, 7, 173, 178
    LTEXT           "EnergyStar keeps background applications efficient without slowing the app you are using.", -1, 14, 20, 159, 36
    LTEXT           "Version 2.0.0", -1, 14, 62, 159, 10
    LTEXT           "Service: EnergyStar Core", -1, 14, 76, 159, 10
    LTEXT           "Power control uses Windows EcoQoS and idle process priority. Windows may deny access to protected processes; add those applications to the whitelist if they must stay responsive.", -1, 14, 96, 159, 72
END
