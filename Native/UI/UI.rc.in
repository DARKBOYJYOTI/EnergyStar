#include <windows.h>
#include "Resource.h"

1 RT_MANIFEST "UI.manifest"

IDD_POWER DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Power"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Power mode", -1, 7, 7, 173, 128
    CONTROL         "Auto - battery only", IDC_MODE_AUTO, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 20, 149, 10
    CONTROL         "Always on", IDC_MODE_ALWAYS, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 56, 149, 10
    CONTROL         "Off", IDC_MODE_OFF, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 92, 149, 10
    LTEXT           "Optimize background apps while on battery.", -1, 24, 32, 149, 20
    LTEXT           "Keep power control active at all times.", -1, 24, 68, 149, 20
    LTEXT           "Disable power control completely.", -1, 24, 104, 149, 20
    GROUPBOX        "Status", -1, 7, 138, 173, 49
    LTEXT           "", IDC_STATUS, 14, 150, 159, 14
    PUSHBUTTON      "Install Service", IDC_POWER_ACTION, 14, 168, 86, 14
END

IDD_WHITELIST DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Whitelist"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Applications that keep full speed", -1, 7, 7, 173, 180
    CONTROL         "", IDC_LIST, "ListBox", LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 14, 18, 159, 144, WS_EX_CLIENTEDGE
    CONTROL         "No applications yet.", IDC_EMPTY, "Static", SS_CENTER | SS_CENTERIMAGE, 14, 18, 159, 144
    PUSHBUTTON      "Add...", IDC_ADD, 14, 168, 54, 14
    PUSHBUTTON      "Remove", IDC_REMOVE, 72, 168, 54, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Debug logging", -1, 7, 7, 173, 44
    CONTROL         "Enable debug log", IDC_LOGGING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 18, 149, 10
    LTEXT           "Save detailed logs for troubleshooting.", -1, 24, 30, 149, 16
    GROUPBOX        "Windows Service", -1, 7, 54, 173, 62
    LTEXT           "Status: Detecting...", IDC_SERVICE_STATUS, 14, 66, 159, 14
    PUSHBUTTON      "Install Service", IDC_SERVICE_INSTALL, 14, 84, 75, 14
    PUSHBUTTON      "Start Service", IDC_SERVICE_TOGGLE, 95, 84, 75, 14
    GROUPBOX        "Data", -1, 7, 120, 173, 67
    LTEXT           "Configuration and logs reside in:", -1, 14, 132, 159, 10
    LTEXT           "Installed: C:\\Program Files\\EnergyStar", -1, 14, 146, 159, 10
    LTEXT           "Portable: folder beside executable", -1, 14, 160, 159, 18
END

IDD_HELP DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Help"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "User Guide & Documentation", -1, 7, 7, 173, 180
    CONTROL         "", IDC_HELP_TEXT, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 14, 20, 159, 160
END

IDD_ABOUT DIALOGEX 0, 0, 187, 196
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "About"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "About EnergyStar", -1, 7, 7, 173, 180
    CONTROL         "<a href=\"https://github.com/DARKBOYJYOTI/EnergyStar\">DARKBOYJYOTI/EnergyStar</a> | <a href=\"https://github.com/imbushuo/EnergyStar\">Original CLI</a>", IDC_ABOUT_LINKS, "SysLink", WS_TABSTOP, 14, 20, 159, 12
    CONTROL         "", IDC_ABOUT_TEXT, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 14, 34, 159, 146
END
