<Window x:Class="EnergyStar.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EnergyStar" Width="1120" Height="760" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="10,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.75" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallWindowButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource AppBackground}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="226" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Sidebar}" CornerRadius="16,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,18,26">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Accent}">
                                <TextBlock Text="E" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EnergyStar" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="POWER CONTROL" FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="10,0,10,13" />
                        <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate_Click" />
                        <Button Style="{StaticResource NavButton}" Content="?   Help" Tag="Help" Click="Navigate_Click" />
                        <Button Style="{StaticResource NavButton}" Content="ⓘ   About" Tag="About" Click="Navigate_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="24,0,0,8" />
                        <Button Style="{StaticResource NavButton}" Content="◈   Overview" Tag="Overview" Click="Navigate_Click" />
                        <Button Style="{StaticResource NavButton}" Content="▣   Exclusions" Tag="Exclusions" Click="Navigate_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◷   Startup" Tag="Startup" Click="Navigate_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="PageTitle" Text="Overview" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <Button Style="{StaticResource SmallWindowButton}" Content="—" Foreground="{DynamicResource TextSecondary}" Click="Minimize_Click" />
                        <Button Style="{StaticResource SmallWindowButton}" Content="×" Foreground="{DynamicResource TextSecondary}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageContent" Margin="28,17,28,24" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
