<Application x:Class="EnergyStar.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F4F6FA" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Sidebar" Color="#F8F9FC" />
        <SolidColorBrush x:Key="TextPrimary" Color="#172033" />
        <SolidColorBrush x:Key="TextSecondary" Color="#697386" />
        <SolidColorBrush x:Key="Accent" Color="#326CE5" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8EFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E7EAF0" />
        <SolidColorBrush x:Key="Success" Color="#178A56" />
        <SolidColorBrush x:Key="Warning" Color="#B96B12" />
    </Application.Resources>
</Application>
